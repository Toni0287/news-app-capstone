# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# ── Django ───────────────────────────────────────────────────────────────
# Generate a key with (see README.md for a Docker-only alternative):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-secret-key

# True for local development, False in production / Docker
DJANGO_DEBUG=True

# Comma-separated list of hostnames the app may be served on
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── MariaDB ──────────────────────────────────────────────────────────────
# Must match the database and user you created in MariaDB (see README.md).
DB_NAME=newsapp_db
DB_USER=newsapp_user
DB_PASSWORD=replace-me-with-your-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# Docker only: password for MariaDB's root user inside the db container
DB_ROOT_PASSWORD=replace-me-with-a-root-password
